# 数据库配置
DATABASE_TYPE=sqlite
DATABASE_PATH=../user/comfyui.db

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 充值比例配置
POINTS_RECHARGE_RATIO=1000
POINTS_INITIAL_BALANCE=100

# 缓存配置
CACHE_BALANCE_TTL=300

# 日志配置
LOGGING_LEVEL=INFO
LOGGING_FILE=logs/points_service.log

# 支付配置
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_NOTIFY_URL=http://your-domain.com/recharge-orders/callback/alipay

WECHAT_APP_ID=your_wechat_app_id
WECHAT_MCH_ID=your_wechat_mch_id
WECHAT_API_KEY=your_wechat_api_key
WECHAT_NOTIFY_URL=http://your-domain.com/recharge-orders/callback/wechat

# 监控配置
MONITORING_ENABLED=true
MONITORING_PROMETHEUS_PORT=9090
